set(DALI_GLES_ENVIRONMENT "NATIVE_EGL" CACHE STRING "GLES environment: NATIVE_EGL or WEB")
set_property(CACHE DALI_GLES_ENVIRONMENT PROPERTY STRINGS NATIVE_EGL WEB)
if(NOT DALI_GLES_ENVIRONMENT MATCHES "^(NATIVE_EGL|WEB)$")
  message(FATAL_ERROR "Invalid DALI_GLES_ENVIRONMENT: ${DALI_GLES_ENVIRONMENT}")
endif()
if(DALI_GLES_ENVIRONMENT STREQUAL "WEB")
  if(DEFINED ENABLE_GRAPHICS_BACKEND)
    string(TOUPPER "${ENABLE_GRAPHICS_BACKEND}" gles_selected_backend)
  else()
    set(gles_selected_backend "GLES")
  endif()
  if(NOT gles_selected_backend STREQUAL "GLES")
    message(FATAL_ERROR "WEB requires ENABLE_GRAPHICS_BACKEND=GLES")
  endif()
  if(NOT EMSCRIPTEN)
    message(FATAL_ERROR "WEB requires the Emscripten toolchain")
  endif()
endif()
